<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold mb-1">My tasks</h1><p class="text-secondary mb-0">Assignments, deadlines and priorities.</p></div><a class="btn btn-primary" href="/tasks/new">+ Add task</a></div>
<% if(!tasks.length){ %><div class="empty-state"><h2 class="h5">No tasks yet</h2><p class="text-secondary">Create a task to keep track of your work.</p><a href="/tasks/new" class="btn btn-primary">Create a task</a></div><% } else { %>
<div class="card app-card p-2 p-md-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Task</th><th>Subject</th><th>Due date</th><th>Priority</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% tasks.forEach(t=>{ %><tr><td><strong><%= t.title %></strong><% if(t.description){ %><div class="small text-secondary"><%= t.description %></div><% } %></td><td><%= t.subject_name || '—' %></td><td><%= t.due_date ? new Date(t.due_date).toLocaleDateString() : '—' %></td><td><span class="badge text-bg-<%= t.priority==='High'?'danger':t.priority==='Low'?'success':'warning' %>"><%= t.priority %></span></td><td><span class="badge text-bg-<%= t.status==='Completed'?'success':t.status==='In Progress'?'info':'secondary' %>"><%= t.status %></span></td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" href="/tasks/<%= t.id %>/edit">Edit</a><% if(t.status!=='Completed'){ %><form method="POST" action="/tasks/<%= t.id %>/complete?_method=PATCH"><button class="btn btn-sm btn-outline-success">Done</button></form><% } %><form method="POST" action="/tasks/<%= t.id %>?_method=DELETE" onsubmit="return confirm('Delete this task?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr><% }) %>
</tbody></table></div></div><% } %>
<%- include('../partials/footer') %>
