<%- include('../partials/header') %>
<div class="auth-wrap">
  <div class="card app-card p-4 p-md-5">
    <h1 class="h3 fw-bold mb-1">Welcome back</h1><p class="text-secondary mb-4">Log in to continue planning.</p>
    <% if (errors.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul></div><% } %>
    <form method="POST" action="/login">
      <div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="<%= form.email || '' %>" required></div>
      <div class="mb-4"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required></div>
      <button class="btn btn-primary w-100">Log in</button>
    </form>
    <p class="text-center mt-4 mb-0 small">New here? <a href="/register">Create an account</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
