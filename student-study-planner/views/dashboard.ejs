<%- include('partials/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div><p class="eyebrow mb-1">YOUR OVERVIEW</p><h1 class="h2 fw-bold mb-0">Dashboard</h1><p class="text-secondary mb-0">A clear view of what you need to study.</p></div>
  <a href="/tasks/new" class="btn btn-primary">+ Add a task</a>
</div>
<div class="card app-card p-3 p-md-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h2 class="h5 fw-bold mb-1"><i class="bi bi-bell"></i> Task notifications</h2>
      <p class="text-secondary mb-0">Enable reminders on this device to be notified about pending tasks due today.</p>
      <p id="notificationStatus" class="small text-secondary mt-2 mb-0" aria-live="polite">Same-day reminders are scheduled for 8:00 AM Bhutan time after server setup.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" id="enableNotifications" class="btn btn-outline-primary">Enable notifications</button>
      <button type="button" id="testNotification" class="btn btn-outline-secondary" disabled>Send test</button>
    </div>
  </div>
</div>
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="stat-card"><span>Subjects</span><strong><%= subjectCount %></strong></div></div>
  <div class="col-6 col-lg-3"><div class="stat-card"><span>Pending tasks</span><strong><%= stats.pending %></strong></div></div>
  <div class="col-6 col-lg-3"><div class="stat-card"><span>In progress</span><strong><%= stats.in_progress %></strong></div></div>
  <div class="col-6 col-lg-3"><div class="stat-card"><span>Completed</span><strong><%= stats.completed %></strong></div></div>
</div>
<div class="row g-4">
  <div class="col-lg-7"><section class="card app-card p-3 p-md-4 h-100">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 fw-bold mb-0">Upcoming tasks</h2><a href="/tasks">View all</a></div>
    <% if (!upcoming.length) { %><p class="text-secondary mb-0">No open tasks yet. Add a task to get started.</p><% } else { %>
      <% upcoming.forEach(task => { %><div class="item-row"><div><strong><%= task.title %></strong><div class="small text-secondary"><%= task.subject_name || 'No subject' %> · Due: <%= task.due_date ? new Date(task.due_date).toLocaleDateString() : 'No date' %></div></div><span class="badge text-bg-<%= task.priority === 'High' ? 'danger' : task.priority === 'Low' ? 'success' : 'warning' %>"><%= task.priority %></span></div><% }) %>
    <% } %>
  </section></div>
  <div class="col-lg-5"><section class="card app-card p-3 p-md-4 h-100">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 fw-bold mb-0">Upcoming study sessions</h2><a href="/study-sessions">View all</a></div>
    <% if (!sessions.length) { %><p class="text-secondary mb-0">No study sessions scheduled yet.</p><% } else { %>
      <% sessions.forEach(item => { %><div class="item-row"><div><strong><%= item.title %></strong><div class="small text-secondary"><%= item.subject_name || 'General study' %> · <%= new Date(item.study_date).toLocaleDateString() %></div></div><span class="small text-nowrap"><%= String(item.start_time).slice(0,5) %></span></div><% }) %>
    <% } %>
  </section></div>
</div>
<div class="card app-card p-3 p-md-4 mt-4">
  <div class="d-flex justify-content-between mb-2"><span class="fw-semibold">Task completion</span><span class="text-secondary small"><%= stats.completed %> of <%= stats.total %> completed</span></div>
  <div class="progress" role="progressbar" aria-label="Task completion" aria-valuenow="<%= stats.total ? Math.round(stats.completed/stats.total*100) : 0 %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:<%= stats.total ? Math.round(stats.completed/stats.total*100) : 0 %>%"></div></div>
</div>
<%- include('partials/footer') %>
