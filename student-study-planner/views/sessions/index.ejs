<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold mb-1">Study schedule</h1><p class="text-secondary mb-0">Plan focused study sessions.</p></div><a class="btn btn-primary" href="/study-sessions/new">+ Add session</a></div>
<% if(!sessions.length){ %><div class="empty-state"><h2 class="h5">No study sessions yet</h2><p class="text-secondary">Schedule your first study session.</p><a href="/study-sessions/new" class="btn btn-primary">Add session</a></div><% } else { %>
<div class="row g-3"><% sessions.forEach(s=>{ %><div class="col-md-6"><div class="card app-card p-3"><div class="d-flex justify-content-between"><div><div class="eyebrow"><%= new Date(s.study_date).toLocaleDateString() %></div><h2 class="h5 fw-bold mt-1"><%= s.title %></h2></div><span class="badge text-bg-primary align-self-start"><%= String(s.start_time).slice(0,5) %>–<%= String(s.end_time).slice(0,5) %></span></div><p class="text-secondary mb-2"><%= s.subject_name || 'General study' %></p><% if(s.notes){ %><p class="small"><%= s.notes %></p><% } %><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="/study-sessions/<%= s.id %>/edit">Edit</a><form method="POST" action="/study-sessions/<%= s.id %>?_method=DELETE" onsubmit="return confirm('Delete this session?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div><% }) %></div>
<% } %>
<%- include('../partials/footer') %>
