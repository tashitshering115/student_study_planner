<%- include('../partials/header') %>
<div class="form-wrap"><div class="card app-card p-4"><h1 class="h3 fw-bold mb-3"><%= title %></h1>
<% if(errors.length){ %><div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(e=>{ %><li><%= e.msg %></li><% }) %></ul></div><% } %>
<form method="POST" action="<%= action %>">
<div class="mb-3"><label class="form-label">Subject name</label><input class="form-control" name="name" required minlength="2" maxlength="100" value="<%= subject.name || '' %>"></div>
<div class="mb-3"><label class="form-label">Color</label><input class="form-control form-control-color" type="color" name="color" value="<%= subject.color || '#4f46e5' %>"></div>
<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"><%= subject.description || '' %></textarea></div>
<div class="d-flex gap-2"><button class="btn btn-primary">Save subject</button><a class="btn btn-light" href="/subjects">Cancel</a></div>
</form></div></div>
<%- include('../partials/footer') %>
