<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold mb-1">My subjects</h1><p class="text-secondary mb-0">Keep your courses organized.</p></div><a class="btn btn-primary" href="/subjects/new">+ Add subject</a></div>
<% if (!subjects.length) { %><div class="empty-state"><h2 class="h5">No subjects yet</h2><p class="text-secondary">Add your first subject to organize tasks and study sessions.</p><a href="/subjects/new" class="btn btn-primary">Add your first subject</a></div><% } else { %>
<div class="row g-3"><% subjects.forEach(s => { %><div class="col-md-6 col-lg-4"><div class="card app-card p-3 h-100"><div class="d-flex align-items-center gap-2 mb-2"><span class="color-dot" style="background:<%= s.color %>"></span><h2 class="h5 mb-0"><%= s.name %></h2></div><p class="text-secondary flex-grow-1"><%= s.description || 'No description added.' %></p><div class="small text-secondary mb-3"><%= s.task_count %> task(s)</div><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="/subjects/<%= s.id %>/edit">Edit</a><form method="POST" action="/subjects/<%= s.id %>?_method=DELETE" onsubmit="return confirm('Delete this subject?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div><% }) %></div>
<% } %>
<%- include('../partials/footer') %>
